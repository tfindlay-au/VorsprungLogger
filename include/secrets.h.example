#ifndef SECRETS_H_INCLUDED
#define SECRETS_H_INCLUDED

/**************************************
* Deployment-specific settings.
*
* Copy this file to `secrets.h` (which is gitignored) and set your own
* endpoint. `config.h` includes it unconditionally, so a missing file is a
* compile error rather than a firmware that builds and transmits nowhere.
**************************************/

// Telemetry server (Traccar). The UDP protocol identifies a device by its
// unique ID alone — there is no shared secret on the wire — so anyone who
// knows both your host and a device ID can inject positions for that device.
// That is why the host lives here and not in config.h.
#define SERVER_HOST "traccar.example.com"

#endif // SECRETS_H_INCLUDED
